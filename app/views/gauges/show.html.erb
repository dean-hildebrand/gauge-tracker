<% content_for :title, "#{@gauge.name} — Gauge Tracker" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-brand-navy"><%= @gauge.name %></h1>
    <p class="mt-0.5 text-sm text-slate-500">
      <%= @gauge.starts_on.to_fs(:long) %> – <%= @gauge.ends_on.to_fs(:long) %>
    </p>
  </div>

  <% if @gauge.created_by_id == current_user.id %>
    <%= link_to "Edit gauge", edit_gauge_path(@gauge),
          class: "rounded-lg border border-brand-green px-4 py-2 font-semibold text-brand-green transition hover:bg-brand-green hover:text-white" %>
  <% end %>
</div>

<div class="mt-4 flex items-center gap-3 text-sm">
  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-600">
    <%= @gauge.unit %>
  </span>
  <span class="rounded-full bg-brand-cyan/10 px-2.5 py-0.5 font-medium text-brand-navy">
    <%= @gauge.time_unit.titleize %>
  </span>
  <span class="text-slate-500">
    <%= pluralize(@gauge.periods.size, "period") %>
  </span>
</div>

<div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-400">
        <th class="px-5 py-3 font-medium">Period</th>
        <th class="px-5 py-3 font-medium">Value</th>
        <th class="px-5 py-3 font-medium">State</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @gauge.periods.each do |period| %>
        <% reading = @readings_by_period[period.first] %>
        <tr>
          <td class="px-5 py-3 font-medium text-brand-navy">
            <%= period_label(period, @gauge.time_unit) %>
          </td>
          <td class="px-5 py-3 text-slate-600">
            <% if reading %>
              <%= number_with_precision(reading.value, precision: 3, strip_insignificant_zeros: true) %>
              <span class="text-slate-400"><%= @gauge.unit %></span>
            <% else %>
              <span class="text-slate-300">—</span>
            <% end %>
          </td>
          <td class="px-5 py-3">
            <% if reading.nil? %>
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">Not entered</span>
            <% elsif reading.approved? %>
              <span class="rounded-full bg-brand-green/10 px-2.5 py-0.5 text-xs font-medium text-brand-green">Approved</span>
            <% else %>
              <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Pending</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
