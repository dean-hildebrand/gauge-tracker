<%# Owns its own wrapper so an empty render (e.g. a Turbo Stream clearing it) collapses. %>
<% if flash.any? { |_, message| message.present? } %>
  <div class="mx-auto mt-6 flex w-full max-w-5xl flex-col gap-2 px-5">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <%# Alerts stay put until dismissed; anything else clears itself after 3s. %>
      <div class="flex items-start justify-between gap-3 rounded-lg border px-4 py-3 text-sm shadow-sm <%=
            { "notice" => "border-green-200 bg-green-50 text-green-800",
              "alert"  => "border-red-200 bg-red-50 text-red-800" }[type.to_s] ||
              "border-slate-200 bg-slate-50 text-slate-700" %>"
           data-controller="flash"
           data-flash-dismiss-after-value="<%= type.to_s == "alert" ? 0 : 3000 %>">
        <span><%= message %></span>
        <% if type.to_s == "alert"%>
          <button type="button" data-action="flash#close" aria-label="Close"
                  class="-my-1 -mr-1 cursor-pointer rounded px-1.5 text-lg leading-none opacity-60 transition hover:opacity-100">&times;</button>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
