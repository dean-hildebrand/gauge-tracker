<% content_for :title, "Sign in — Gauge Tracker" %>

<div class="fixed inset-0 overflow-y-auto bg-brand-navy px-4 py-10 flex items-center justify-center">
  <div class="w-full max-w-md">

    <div class="mb-8 flex items-center justify-center gap-3">
      <span class="text-xl font-bold tracking-tight text-white">Gauge Tracker</span>
    </div>

    <%# Card %>
    <div class="rounded-2xl bg-white p-8 shadow-xl">
      <h1 class="text-2xl font-bold text-brand-navy">Sign in</h1>

      <% if flash.any? { |_, message| message.present? } %>
        <div class="mb-5 flex flex-col gap-2">
          <%= render "shared/flash" %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 placeholder-slate-400 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/40 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 placeholder-slate-400 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/40 focus:outline-none" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 text-sm text-slate-600">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 accent-brand-green" %>
              <%= f.label :remember_me, "Remember me", class: "select-none" %>
            </label>
          <% end %>

          <%= f.submit "Sign in",
                class: "w-full cursor-pointer rounded-lg bg-brand-green px-4 py-2.5 font-semibold text-white transition hover:bg-brand-green-dark focus:ring-2 focus:ring-brand-green/50 focus:outline-none" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
